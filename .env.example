# PostgreSQL (required — set on Vercel for Production and Preview builds)
# Example Neon: postgresql://user:pass@host/neondb?sslmode=require&schema=public
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/mahasetu?schema=public"

# HMAC secret for session cookies (min 16 characters). Required on Vercel.
SESSION_SECRET="replace-with-a-long-random-secret"

# Google Gemini — MahaSetu assistant chatbot
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.0-flash"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Used only by prisma/seed.js to create the first admin and officer accounts
ADMIN_EMAIL="admin@mahasetu.gov.in"
ADMIN_PASSWORD="ChangeMe#2026"
SEED_PASSWORD="ChangeMe#2026"
