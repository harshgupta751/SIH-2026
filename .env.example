# PostgreSQL (required)
# Example local: postgresql://postgres:postgrespassword@localhost:5432/mahasetu?schema=public
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/mahasetu?schema=public"

# HMAC secret for session cookies (min 16 characters). Generate a long random string in production.
SESSION_SECRET="replace-with-a-long-random-secret"

# Google Gemini — powers the in-app MahaSetu assistant (required for full chatbot)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.0-flash"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Used only by prisma/seed.js to create the first admin and officer accounts
ADMIN_EMAIL="admin@mahasetu.gov.in"
ADMIN_PASSWORD="ChangeMe#2026"
SEED_PASSWORD="ChangeMe#2026"
