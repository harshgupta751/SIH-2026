// This is your Prisma schema file for MahaSetu

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  role         String    // CITIZEN, OFFICER_MUNICIPAL, OFFICER_REVENUE, OFFICER_EMPLOYMENT, ADMIN
  departmentId String?
  citizen      Citizen?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Citizen {
  id           String        @id @default(cuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  mobile       String
  aadhaarHash  String        @unique
  addressLine  String
  locality     String
  city         String
  district     String
  state        String
  postalCode   String
  applications Application[]
  consents     Consent[]
  notifications Notification[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Department {
  id          String        @id @default(cuid())
  code        String        @unique // REVENUE, MUNICIPAL, EMPLOYMENT
  name        String
  description String
  icon        String
  apiBaseUrl  String
  status      String        @default("HEALTHY") // HEALTHY, DEGRADED, DOWN
  services    Service[]
  applications Application[]
  integrations Integration[]
  mappings    FieldMapping[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Service {
  id                  String        @id @default(cuid())
  code                String        @unique // BUSINESS_LICENSE, ADDRESS_VERIFICATION, SKILL_SUBSIDY
  name                String
  departmentId        String
  department          Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  description         String
  requiredClearances  String        // JSON string array e.g. ["REVENUE_ADDRESS_VERIFICATION"]
  slaDays             Int           @default(7)
  fee                 Float         @default(0.0)
  applications        Application[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model Application {
  id                   String                @id @default(cuid())
  applicationNumber    String                @unique // e.g. MH-MUNI-2026-10231
  citizenId            String
  citizen              Citizen               @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  serviceId            String
  service              Service               @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  departmentId         String
  department           Department            @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  status               String                @default("DRAFT") // DRAFT, CONSENT_PENDING, REVENUE_VERIFIED, PENDING_OFFICER_REVIEW, APPROVED, REJECTED
  payloadJson          String                // JSON data submitted by applicant / normalized by adapters
  revenueClearanceRef  String?
  municipalPermitRef   String?
  consents             Consent[]
  timelines            ApplicationTimeline[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model ApplicationTimeline {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stage         String      // CREATED, CONSENT_GRANTED, REVENUE_VERIFIED, ADAPTER_TRANSLATED, OFFICER_REVIEW, APPROVED, REJECTED
  status        String      // SUCCESS, PENDING, ERROR
  details       String
  actor         String
  timestamp     DateTime    @default(now())
}

model Consent {
  id             String       @id @default(cuid())
  citizenId      String
  citizen        Citizen      @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  applicationId  String
  application    Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requestedByDept String      // MUNICIPAL, etc.
  sourceDept     String       // REVENUE, etc.
  purpose        String
  dataFields     String       // JSON string array of requested fields e.g. ["name", "address", "property_tax_cleared"]
  status         String       @default("PENDING") // PENDING, GRANTED, DENIED, REVOKED
  grantedAt      DateTime?
  revokedAt      DateTime?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Integration {
  id             String     @id @default(cuid())
  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name           String     // "RevNet Citizen Registry", "MuniSys Licensing Engine"
  endpointUrl    String
  authType       String     @default("API_KEY") // API_KEY, OAUTH2, MUTUAL_TLS
  status         String     @default("CONNECTED") // CONNECTED, DISCONNECTED, ERROR
  responseTimeMs Int        @default(45)
  lastHealthCheck DateTime  @default(now())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model FieldMapping {
  id             String     @id @default(cuid())
  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  sourceSystem   String     // RevNet, MuniSys, KaushalPortal
  sourceField    String     // e.g. "citizen.fullName", "address_record.city_name"
  targetSystem   String     // MahaSetu_CDM
  targetField    String     // e.g. "name", "address.city"
  transformation String?    // e.g. "DIRECT", "TO_UPPER", "CONCAT_ADDRESS", "BOOLEAN_FLAG"
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String
  actorRole    String
  action       String   // CONSENT_GRANTED, REVENUE_FETCH, MAPPING_TRANSFORM, MUNICIPAL_DISPATCH, APPLICATION_APPROVED
  entityType   String   // APPLICATION, CONSENT, INTEGRATION, MAPPING
  entityId     String
  department   String
  purpose      String
  detailsJson  String
  ipAddress    String   @default("127.0.0.1")
  hash         String   // Cryptographic SHA-256 integrity hash
  timestamp    DateTime @default(now())
}

model Event {
  id          String   @id @default(cuid())
  eventType   String   // APPLICATION_CREATED, CONSENT_GRANTED, REVENUE_VERIFIED, APPLICATION_APPROVED, NOTIFICATION_DISPATCHED
  source      String   // CITIZEN_PORTAL, REVENUE_ADAPTER, MUNICIPAL_ADAPTER, MAHASETU_CORE
  payloadJson String
  processed   Boolean  @default(true)
  timestamp   DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  citizenId String
  citizen   Citizen  @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, ACTION_REQUIRED
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
